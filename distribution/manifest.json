{
  "schema_version": 1,
  "distribution_version": "v5.0.0",
  "source_repository": "OasisSaber/TheMasterplan",
  "required": [
    "core/workflow.md",
    "core/policy.md"
  ],
  "components": {
    "profiles": [
      "git",
      "jj"
    ]
  },
  "files": [
    {
      "source": "core/workflow.md",
      "destination": "core/workflow.md",
      "ownership": "managed-replace",
      "required": true
    },
    {
      "source": "core/policy.md",
      "destination": "core/policy.md",
      "ownership": "managed-replace",
      "required": true
    },
    {
      "source": "profiles/git.md",
      "destination": "profiles/git.md",
      "ownership": "managed-replace",
      "required": false
    },
    {
      "source": "profiles/jj.md",
      "destination": "profiles/jj.md",
      "ownership": "managed-replace",
      "required": false
    },
    {
      "source": "skills/themasterplan/references/jj-lifecycle.md",
      "destination": "skills/themasterplan/references/jj-lifecycle.md",
      "ownership": "managed-replace",
      "required": false
    },
    {
      "source": "docs/client-update-flow.md",
      "destination": "docs/client-update-flow.md",
      "ownership": "managed-replace",
      "required": false
    },
    {
      "source": "skills/themasterplan/scripts/tmlib/update_check.py",
      "destination": ".themasterplan/bin/tmlib/update_check.py",
      "ownership": "managed-replace",
      "required": true
    },
    {
      "source": "distribution/templates/agents-managed-block.md",
      "destination": "AGENTS.md",
      "ownership": "managed-block",
      "required": true
    },
    {
      "source": "distribution/templates/consumer-workflow.yml",
      "destination": ".github/workflows/check.yml",
      "ownership": "generated-if-missing",
      "required": false
    },
    {
      "source": "distribution/templates/project-check-placeholder.sh",
      "destination": "scripts/check.sh",
      "ownership": "generated-if-missing",
      "required": false
    }
  ]
}
